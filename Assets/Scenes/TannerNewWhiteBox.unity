      value: 
      objectReference: {fileID: 391597838}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: memoDialogue.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: memoDialogueG.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: memoDialogueL.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogue.Array.data[0]'
      value: Gamer!
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[0]'
      value: '"Oh. Hm."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[1]'
      value: '"I can''t read."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[2]'
      value: '"Oh. Dang." '
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[3]'
      value: '"It''s a note from my boss."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[4]'
      value: '"...Do you do this a lot?"'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[5]'
      value: '"Help people, I mean."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[6]'
      value: '"Sure. But normally I''m not talking to anyone who knew the dead guy."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[7]'
      value: '"I kinda prefer it this way, though."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[8]'
      value: '"Still, it''s important to honor the dead."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueG.Array.data[9]'
      value: You nod.
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[0]'
      value: She takes a solid minute to read the memo, her eyes narrowing as she
        does.
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[1]'
      value: '"What in the world?"'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[2]'
      value: '"Yeah. He''s really on my ass."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[3]'
      value: '"..."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[4]'
      value: '"I suppose so."'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[5]'
      value: '"You really think you should listen?"'
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: 'memoDialogueL.Array.data[6]'
      value: You shrug.
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: rustyKeyDialogueG.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
