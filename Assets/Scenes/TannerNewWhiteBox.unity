      value: 29
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
      propertyPath: roseBoquetDialogueG.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 1676594812203147298, guid: 3fffff87a7c95c345b9a68e39def842b, type: 3}
